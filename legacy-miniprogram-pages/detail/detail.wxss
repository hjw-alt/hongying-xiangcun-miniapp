.art-stage {
  position: relative;
  height: 66vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 22%, rgba(232, 163, 61, 0.34) 0%, rgba(232, 163, 61, 0) 52%),
    linear-gradient(180deg, #33201A 0%, #1E1411 100%);
}

.art-stage image {
  width: 100%;
  height: 100%;
}

.stage-veil {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(20, 12, 9, 0.2) 0%, rgba(20, 12, 9, 0) 46%, rgba(20, 12, 9, 0.62) 100%);
}

.plate {
  position: relative;
  margin: -48rpx 32rpx 24rpx;
  padding: 34rpx;
  background: var(--surface-solid);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-float);
}

.plate-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.title {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 42rpx;
  line-height: 58rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.theme {
  flex-shrink: 0;
  margin-top: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  font-size: 21rpx;
  line-height: 32rpx;
}

.theme.puppet {
  background: rgba(71, 97, 79, 0.92);
  color: #F2EBD8;
}

.theme.impress {
  background: rgba(195, 154, 75, 0.94);
  color: #2E2119;
}

.theme.story {
  background: rgba(169, 54, 40, 0.94);
  color: #FDF3DC;
}

.meta {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 34rpx;
}

.description {
  margin-top: 20rpx;
  color: var(--ink-2);
  font-size: 27rpx;
  line-height: 46rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 6rpx 14rpx;
  border: 1rpx solid var(--line-soft);
  border-radius: 999rpx;
  background: rgba(251, 242, 222, 0.7);
  color: var(--ink-2);
  font-size: 21rpx;
  line-height: 32rpx;
}

.detail-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 1rpx dashed var(--line);
}

.detail-actions button {
  width: calc(50% - 7rpx);
  height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  line-height: 74rpx;
  letter-spacing: 2rpx;
}

.detail-actions .primary {
  background: linear-gradient(180deg, #B8402F 0%, var(--cinnabar-deep) 100%);
  color: #FDF3DC;
  font-weight: 600;
  box-shadow: 0 6rpx 0 rgba(91, 33, 27, 0.2);
}

.detail-actions button:not(.primary) {
  border: 1rpx solid var(--line);
  background: rgba(251, 242, 222, 0.64);
  color: var(--ink-2);
}

.detail-actions .danger {
  border-color: rgba(169, 54, 40, 0.34);
  background: rgba(169, 54, 40, 0.12);
  color: var(--cinnabar);
}

.detail-actions .favorite.active {
  border-color: rgba(195, 154, 75, 0.6);
  background: rgba(195, 154, 75, 0.22);
  color: #8A6A28;
}

.comment-panel {
  margin: 0 32rpx 48rpx;
}

.comment-form input,
.comment-form textarea {
  width: 100%;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: rgba(255, 252, 244, 0.94);
  color: var(--ink);
  font-family: inherit;
  font-size: 26rpx;
}

.comment-form input {
  height: 84rpx;
  padding: 0 22rpx;
  margin-bottom: 14rpx;
  line-height: 84rpx;
}

.comment-form textarea {
  height: 190rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 18rpx;
  line-height: 44rpx;
}

.comment-form button {
  width: 100%;
  height: 82rpx;
  line-height: 80rpx;
  background: linear-gradient(180deg, #B8402F 0%, var(--cinnabar-deep) 100%);
  color: #FDF3DC;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.comment-list {
  margin-top: 28rpx;
}

.comment {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.comment:last-child {
  border-bottom: 0;
}

.comment-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 32rpx;
}

.nickname {
  color: var(--ink);
  font-size: 25rpx;
  line-height: 36rpx;
  font-weight: 700;
}

.time {
  color: var(--muted);
  font-size: 22rpx;
  line-height: 32rpx;
}

.content {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 44rpx;
}

.comment-action {
  margin-top: 12rpx;
  color: var(--cinnabar);
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: right;
}

.empty {
  margin: 26rpx 32rpx 0;
  padding: 40rpx 28rpx;
  border: 1rpx dashed var(--line);
  border-radius: var(--radius);
  background: rgba(251, 242, 222, 0.7);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 38rpx;
  text-align: center;
}

.comment-panel .empty {
  margin: 20rpx 0 0;
}
