.cart-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 32rpx 0;
  padding: 18rpx 22rpx;
  background: linear-gradient(120deg, #9a2928 0%, #bd7146 100%);
  border: 0;
  box-shadow: var(--shadow-float);
}

.cart-head-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border: 2rpx solid rgba(255, 246, 232, 0.8);
  border-radius: 50%;
  color: #fff6e8;
  font-family: "Songti SC", "STSong", serif;
  font-size: 25rpx;
}

.cart-head-copy {
  flex: 1;
  min-width: 0;
}

.cart-head-title,
.cart-head-sub {
  display: block;
  overflow: hidden;
  color: #fff6e8;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cart-head-title {
  font-size: 25rpx;
  font-weight: 600;
}

.cart-head-sub {
  margin-top: 4rpx;
  color: rgba(255, 246, 232, 0.78);
  font-size: 20rpx;
}

.cart-head-arrow {
  flex-shrink: 0;
  color: #fff6e8;
  font-size: 21rpx;
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 24rpx 32rpx 0;
}

.cart-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
}

.check {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--line);
  border-radius: 50%;
  background: var(--surface);
}

.check.checked {
  border-color: var(--red);
  background: var(--red);
  box-shadow: inset 0 0 0 8rpx #FFFFFF;
}

.cart-cover {
  flex-shrink: 0;
  width: 170rpx;
  height: 170rpx;
  border-radius: var(--radius-sm);
  background: var(--paper-deep);
}

.cart-info {
  flex: 1;
  min-width: 0;
}

.cart-name {
  display: -webkit-box;
  overflow: hidden;
  color: var(--ink);
  font-size: 27rpx;
  line-height: 38rpx;
  font-weight: 600;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.cart-custom {
  display: block;
  margin-top: 8rpx;
  color: var(--gold);
  font-size: 22rpx;
}

.cart-farmer {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.cart-rewards {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
  color: var(--red);
  font-size: 20rpx;
  line-height: 28rpx;
}

.cart-rewards text {
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(179, 42, 42, 0.08);
}

.cart-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 12rpx;
}

.cart-foot .price {
  display: block;
  font-size: 30rpx;
}

.cart-points-price {
  display: block;
  margin-top: 2rpx;
  color: var(--gold);
  font-size: 20rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.step-button {
  width: 52rpx;
  height: 52rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  color: var(--ink-2);
  font-size: 28rpx;
  line-height: 50rpx;
  text-align: center;
}

.step-value {
  min-width: 40rpx;
  font-size: 27rpx;
  font-weight: 600;
  text-align: center;
}

.cart-remove {
  display: inline-block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.payment-panel {
  padding: 26rpx;
}

.payment-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.payment-title {
  display: block;
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 29rpx;
  font-family: "Songti SC", "STSong", serif;
  font-weight: 700;
}

.payment-points {
  color: var(--red);
  font-size: 21rpx;
}

.payment-switch {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.payment-option {
  flex: 1;
  min-width: 0;
  padding: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-warm);
}

.payment-option.active {
  border-color: var(--red);
  background: rgba(179, 42, 42, 0.07);
  box-shadow: inset 0 0 0 2rpx rgba(179, 42, 42, 0.08);
}

.payment-option.disabled {
  opacity: 0.52;
}

.payment-option-title,
.payment-option-value,
.payment-option-sub {
  display: block;
}

.payment-option-title {
  color: var(--ink-2);
  font-size: 22rpx;
}

.payment-option-value {
  margin-top: 4rpx;
  color: var(--red);
  font-size: 28rpx;
  font-weight: 700;
}

.payment-option-sub {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 29rpx;
}

.payment-hint {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 32rpx;
}

.bottom-placeholder {
  height: 190rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--line);
}

.select-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.select-all .check {
  width: 36rpx;
  height: 36rpx;
}

.total {
  flex: 1;
  min-width: 0;
  text-align: right;
}

.total-label {
  display: block;
  color: var(--muted);
  font-size: 21rpx;
}

.total-value {
  display: block;
  color: var(--red);
  font-size: 32rpx;
  font-weight: 700;
}

.checkout-button {
  flex-shrink: 0;
  width: 230rpx;
  height: 80rpx;
  line-height: 78rpx;
  background: linear-gradient(180deg, #C13A32 0%, #8C1F1F 100%);
  color: #FFF6E8;
  font-size: 28rpx;
  font-weight: 600;
}

.cart-state {
  margin: 24rpx 32rpx 0;
}

.empty-button {
  margin-top: 22rpx;
}
