.hero-title {
  margin-top: 14rpx;
  color: #FFF6E8;
  font-size: 46rpx;
  line-height: 62rpx;
  font-weight: 700;
  font-family: "Songti SC", "STSong", serif;
  letter-spacing: 3rpx;
}

.hero-sub {
  margin-top: 10rpx;
  color: rgba(255, 246, 232, 0.82);
  font-size: 24rpx;
  line-height: 36rpx;
}

.stat-card {
  display: flex;
  margin: -36rpx 32rpx 0;
  padding: 26rpx 0;
  position: relative;
  z-index: 2;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  color: var(--red);
  font-size: 40rpx;
  line-height: 50rpx;
  font-weight: 700;
}

.stat-label {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.farmer-list,
.product-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.farmer-card {
  padding: 24rpx;
}

.farmer-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.farmer-avatar {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--paper-deep);
}

.farmer-info {
  flex: 1;
  min-width: 0;
}

.farmer-name {
  display: block;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.farmer-village {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.farmer-count {
  flex-shrink: 0;
  color: var(--red);
  font-size: 26rpx;
  font-weight: 700;
}

.farmer-intro {
  display: block;
  margin-top: 14rpx;
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 38rpx;
}

.farmer-project {
  display: block;
  margin-top: 10rpx;
  color: var(--gold);
  font-size: 23rpx;
}

.farmer-card .progress {
  margin-top: 18rpx;
}

.farmer-target {
  display: block;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.product-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
}

.product-cover {
  flex-shrink: 0;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
  background: var(--paper-deep);
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-name {
  display: block;
  color: var(--ink);
  font-size: 29rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.product-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 23rpx;
  line-height: 34rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.product-foot .price {
  font-size: 30rpx;
}

.product-farmer {
  color: var(--muted);
  font-size: 21rpx;
}
