.cover {
  width: 100%;
  height: 560rpx;
  background: var(--paper-deep);
}

.head-card {
  position: relative;
  margin: -50rpx 32rpx 0;
  padding: 30rpx;
  z-index: 2;
}

.head-tags {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.head-era {
  color: var(--gold);
  font-size: 22rpx;
}

.title {
  display: block;
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 40rpx;
  line-height: 54rpx;
  font-weight: 700;
  font-family: "Songti SC", "STSong", serif;
}

.meta {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.content {
  display: block;
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 27rpx;
  line-height: 48rpx;
  text-align: justify;
}

.ar-tip {
  display: block;
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 38rpx;
}

.ar-panel {
  border-left: 6rpx solid rgba(199, 154, 70, 0.5);
}

.ar-preview {
  width: 100%;
  height: 380rpx;
  margin-top: 16rpx;
  border-radius: var(--radius-sm);
  background: var(--paper-deep);
}

.ar-button {
  width: 100%;
  height: 78rpx;
  margin-top: 16rpx;
  line-height: 76rpx;
  font-size: 26rpx;
}

.village-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 14rpx;
}

.village-cover {
  flex-shrink: 0;
  width: 140rpx;
  height: 110rpx;
  border-radius: var(--radius-sm);
}

.village-info {
  flex: 1;
  min-width: 0;
}

.village-name {
  display: block;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.village-region {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.village-arrow {
  color: var(--muted);
  font-size: 34rpx;
}

.action-placeholder {
  height: 160rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--line);
}

.ar-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(24, 16, 12, 0.92);
}

.ar-stage {
  width: 100%;
  padding: 0 32rpx;
}

.ar-image {
  width: 100%;
  height: 900rpx;
}

.ar-close {
  display: block;
  margin-top: 20rpx;
  color: rgba(255, 246, 232, 0.72);
  font-size: 24rpx;
  text-align: center;
}

.story-state {
  margin: 32rpx;
}
