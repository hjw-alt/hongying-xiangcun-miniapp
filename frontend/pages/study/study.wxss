.study-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin: 24rpx 32rpx 0;
  padding: 28rpx 30rpx 30rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, #fffaf2 0%, #f2dfca 100%);
  border: 1rpx solid #e7d3bd;
  box-shadow: var(--shadow-card);
}

.study-head-copy {
  flex: 1;
  min-width: 0;
}

.study-title {
  display: block;
  margin-top: 8rpx;
  color: var(--red-deep);
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  line-height: 52rpx;
  font-weight: 700;
}

.study-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 34rpx;
}

.study-head-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 102rpx;
  height: 102rpx;
  border: 2rpx solid var(--red);
  border-radius: 50%;
  color: var(--red);
  font-family: "Songti SC", "STSong", serif;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
  transform: rotate(8deg);
}

.points-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 18rpx 32rpx 0;
  padding: 34rpx 32rpx;
  border-radius: var(--radius);
  background: linear-gradient(140deg, #B33A32 0%, #7E1B1B 100%);
  box-shadow: var(--shadow-float);
}

.points-num {
  display: block;
  color: #FFF6E8;
  font-size: 64rpx;
  line-height: 76rpx;
  font-weight: 700;
  font-family: "Songti SC", "STSong", serif;
}

.points-main {
  flex: 1;
  min-width: 0;
}

.points-label {
  display: block;
  color: rgba(255, 246, 232, 0.76);
  font-size: 23rpx;
}

.points-side {
  text-align: right;
}

.points-level,
.points-exp {
  display: block;
  color: rgba(255, 246, 232, 0.88);
  font-size: 23rpx;
  line-height: 32rpx;
}

.points-exp {
  margin-top: 4rpx;
  color: rgba(255, 246, 232, 0.72);
  font-size: 21rpx;
}

.points-link {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(255, 246, 232, 0.5);
  border-radius: 999rpx;
  color: #FFF6E8;
  font-size: 22rpx;
}

.study-benefits {
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 12rpx;
  margin: 18rpx 32rpx 0;
  padding: 22rpx 16rpx;
}

.benefit-item {
  flex: 1;
  text-align: center;
}

.benefit-value {
  display: block;
  color: var(--red);
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 700;
}

.benefit-label {
  display: block;
  margin-top: 3rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 28rpx;
}

.benefit-divider {
  width: 1rpx;
  height: 44rpx;
  background: var(--line);
}

.village-scroll {
  white-space: nowrap;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin: 24rpx 32rpx 0;
}

.task-card {
  overflow: hidden;
}

.task-done {
  opacity: 0.72;
}

.task-cover {
  width: 100%;
  height: 280rpx;
  background: var(--paper-deep);
}

.task-body {
  padding: 24rpx;
}

.task-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.task-type {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(199, 154, 70, 0.2);
  color: #8A6420;
  font-size: 21rpx;
}

.task-rewards {
  flex-shrink: 0;
  text-align: right;
}

.task-points,
.task-exp {
  display: block;
  color: var(--red);
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 700;
}

.task-exp {
  color: var(--gold);
  font-size: 20rpx;
  font-weight: 500;
}

.task-title {
  display: block;
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
}

.task-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 38rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-soft);
}

.task-state {
  color: var(--red);
  font-size: 24rpx;
  font-weight: 600;
}

.task-state.done {
  color: var(--jade);
}

.task-arrow {
  color: var(--muted);
  font-size: 34rpx;
  line-height: 34rpx;
}

.record-list {
  padding: 10rpx 26rpx;
}

.record-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.record-item:last-child {
  border-bottom: 0;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-title {
  display: block;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--ink);
  font-size: 27rpx;
  line-height: 38rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.record-note {
  display: block;
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 36rpx;
}

.record-points {
  flex-shrink: 0;
  color: var(--red);
  font-size: 22rpx;
}

.record-time {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.task-empty {
  margin: 24rpx 32rpx 0;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  background: rgba(46, 33, 25, 0.46);
}

.modal {
  width: 100%;
  padding: 34rpx 32rpx calc(112rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--surface);
}

.modal-title {
  display: block;
  color: var(--red-deep);
  font-size: 34rpx;
  line-height: 46rpx;
  font-weight: 700;
}

.modal-sub {
  display: block;
  margin-top: 8rpx;
  color: var(--red);
  font-size: 23rpx;
}

.modal-body {
  display: block;
  margin-top: 14rpx;
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 40rpx;
}

.modal-textarea {
  width: 100%;
  height: 160rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-warm);
  font-size: 25rpx;
  line-height: 38rpx;
}

.photo-row {
  margin: 18rpx 0 24rpx;
}

.photo-preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
}

.photo-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border: 1rpx dashed var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-warm);
  color: var(--muted);
  font-size: 23rpx;
}
