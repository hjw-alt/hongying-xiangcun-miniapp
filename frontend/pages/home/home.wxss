.home-page {
  background: #f5f6f7;
}

.home-hero {
  padding-bottom: 28rpx;
  background: linear-gradient(180deg, #fbf1e9 0%, #f8e9de 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.home-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 32rpx 20rpx;
}

.brand-lockup {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  background: var(--red);
  color: #fff9f1;
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 16rpx rgba(179, 42, 42, 0.2);
}

.brand-copy {
  min-width: 0;
  margin-left: 16rpx;
}

.brand-name {
  display: block;
  overflow: hidden;
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.brand-sub {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 28rpx;
}

.topbar-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.round-tool {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border: 1rpx solid rgba(126, 27, 27, 0.1);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  color: var(--red);
  font-size: 21rpx;
  font-weight: 600;
}

.cart-tool image {
  width: 38rpx;
  height: 38rpx;
}

.tool-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border-radius: 999rpx;
  background: var(--red);
  color: #fff;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
}

.hero-swiper {
  height: 408rpx;
  margin: 0 24rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: var(--paper-deep);
  box-shadow: 0 14rpx 34rpx rgba(113, 72, 48, 0.16);
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-shade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(48, 22, 12, 0.02) 30%, rgba(48, 22, 12, 0.72) 100%);
}

.hero-copy {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 42rpx;
}

.hero-kicker {
  display: block;
  color: rgba(255, 248, 236, 0.82);
  font-size: 21rpx;
  line-height: 30rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 6rpx;
  color: #fffaf1;
  font-family: "Songti SC", "STSong", serif;
  font-size: 43rpx;
  line-height: 56rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.2);
}

.hero-subtitle {
  display: block;
  max-width: 560rpx;
  margin-top: 4rpx;
  overflow: hidden;
  color: rgba(255, 250, 241, 0.86);
  font-size: 22rpx;
  line-height: 32rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero-cta {
  display: inline-block;
  margin-top: 14rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(255, 250, 241, 0.62);
  border-radius: 999rpx;
  color: #fffaf1;
  font-size: 21rpx;
  line-height: 28rpx;
}

.member-card {
  margin: -2rpx 24rpx 0;
  overflow: hidden;
  border: 0;
  border-radius: 26rpx;
  box-shadow: 0 10rpx 30rpx rgba(63, 45, 34, 0.1);
}

.member-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #b8a78e;
  color: #fffdf8;
}

.member-level {
  display: flex;
  align-items: center;
  min-width: 0;
}

.member-level-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  font-family: "Songti SC", "STSong", serif;
  font-size: 20rpx;
  font-weight: 700;
}

.member-level-title {
  flex-shrink: 0;
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 700;
}

.member-level-tip {
  overflow: hidden;
  margin-left: 16rpx;
  color: rgba(255, 253, 248, 0.8);
  font-size: 21rpx;
  line-height: 30rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.member-upgrade {
  flex-shrink: 0;
  color: #fffdf8;
  font-size: 22rpx;
  line-height: 32rpx;
}

.member-main {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 20rpx;
  background: #fff;
}

.member-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border: 6rpx solid #f9efe5;
  border-radius: 50%;
  background: #e8c98c;
  color: var(--red-deep);
  font-family: "Songti SC", "STSong", serif;
  font-size: 36rpx;
  font-weight: 700;
}

.member-user {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.member-name {
  display: block;
  color: var(--ink);
  font-size: 29rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.member-note {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 30rpx;
}

.member-stats {
  display: flex;
  padding: 16rpx 0 20rpx;
  border-top: 1rpx solid #f3eeea;
  background: #fff;
}

.member-stat {
  position: relative;
  flex: 1;
  text-align: center;
}

.member-stat + .member-stat::before {
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 1rpx;
  height: 42rpx;
  background: #ebe5df;
  content: "";
}

.member-stat-num {
  display: block;
  color: var(--ink);
  font-size: 29rpx;
  line-height: 38rpx;
}

.member-stat-label {
  display: block;
  margin-top: 2rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 28rpx;
}

.section {
  margin: 30rpx 24rpx 0;
}

.compact-head {
  margin-bottom: 16rpx;
}

.section-head {
  margin-bottom: 18rpx;
}

.eyebrow {
  color: var(--red);
  font-size: 20rpx;
  line-height: 28rpx;
  letter-spacing: 3rpx;
}

.section-title {
  margin-top: 4rpx;
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  line-height: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.more {
  color: var(--muted);
  font-size: 22rpx;
  line-height: 32rpx;
}

.service-card {
  display: flex;
  padding: 24rpx 8rpx 22rpx;
  border: 0;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(63, 45, 34, 0.08);
}

.service-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.service-divider {
  position: absolute;
  left: 0;
  top: 18rpx;
  width: 1rpx;
  height: 112rpx;
  background: #edd5d3;
}

.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 26rpx;
  color: var(--red);
  font-family: "Songti SC", "STSong", serif;
  font-size: 33rpx;
  font-weight: 700;
}

.service-guide { background: #f8e8de; }
.service-mall { background: #f8efd9; }
.service-story { background: #e9efea; }
.service-study { background: #f1e8f0; }

.service-title {
  display: block;
  margin-top: 12rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.service-sub {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 26rpx;
}

.benefits-section,
.honor-section {
  margin-top: 24rpx;
}

.benefit-card,
.honor-card {
  border: 0;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(63, 45, 34, 0.08);
}

.benefit-card {
  padding: 24rpx 14rpx 16rpx;
}

.benefit-head,
.honor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx;
}

.benefit-title,
.honor-title {
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 29rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.honor-count {
  color: var(--muted);
  font-size: 21rpx;
  line-height: 30rpx;
}

.benefit-list {
  display: flex;
  margin-top: 20rpx;
}

.benefit-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.benefit-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f5f5f3;
  color: #807a73;
  font-size: 28rpx;
}

.benefit-name {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 21rpx;
  line-height: 30rpx;
}

.benefit-sub {
  display: block;
  margin-top: 2rpx;
  overflow: hidden;
  color: #b6afa8;
  font-size: 17rpx;
  line-height: 24rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.honor-card {
  padding: 22rpx 14rpx 14rpx;
}

.honor-title-wrap {
  display: flex;
  align-items: center;
}

.honor-emblem {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #faeee0;
  color: var(--red);
  font-size: 22rpx;
}

.honor-count text {
  color: var(--red);
  font-size: 28rpx;
  font-weight: 700;
}

.honor-body {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 190rpx;
  margin-top: 16rpx;
  padding: 24rpx 20rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: linear-gradient(120deg, #faf4ea 0%, #fefbf6 100%);
}

.honor-body::after {
  position: absolute;
  right: -24rpx;
  bottom: -70rpx;
  width: 230rpx;
  height: 230rpx;
  border: 1rpx solid rgba(199, 154, 70, 0.16);
  border-radius: 50%;
  content: "";
}

.honor-medal {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 126rpx;
  height: 126rpx;
  border: 8rpx solid #efe0c8;
  border-radius: 34rpx;
  background: #fffaf2;
  color: var(--red);
  font-family: "Songti SC", "STSong", serif;
  font-size: 54rpx;
  font-weight: 700;
  transform: rotate(-7deg);
}

.honor-copy {
  z-index: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.honor-name {
  display: block;
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.honor-sub {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 30rpx;
}

.honor-action {
  display: inline-block;
  margin-top: 14rpx;
  color: var(--red);
  font-size: 21rpx;
  line-height: 30rpx;
}

.honor-progress {
  position: absolute;
  right: 16rpx;
  top: 12rpx;
  z-index: 2;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #f5ead8;
  color: var(--muted);
  font-size: 19rpx;
}

.honor-progress text {
  color: var(--red);
  font-size: 25rpx;
  font-weight: 700;
}

.village-scroll,
.product-scroll {
  width: 100%;
  white-space: nowrap;
}

.village-row,
.product-row {
  display: flex;
  gap: 18rpx;
  padding: 2rpx 2rpx 12rpx;
}

.village-card {
  flex-shrink: 0;
  width: 304rpx;
  overflow: hidden;
  border: 0;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 22rpx rgba(63, 45, 34, 0.08);
}

.village-cover {
  width: 100%;
  height: 204rpx;
  background: var(--paper-deep);
}

.village-body {
  padding: 16rpx 18rpx 18rpx;
}

.village-name {
  display: block;
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 700;
}

.village-region {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 28rpx;
}

.village-stats {
  display: flex;
  gap: 18rpx;
  margin-top: 10rpx;
  color: var(--red);
  font-size: 20rpx;
  line-height: 28rpx;
}

.product-card {
  flex-shrink: 0;
  width: 270rpx;
  overflow: hidden;
  border: 0;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 22rpx rgba(63, 45, 34, 0.08);
}

.product-cover {
  width: 100%;
  height: 264rpx;
  background: #f6eee4;
}

.product-body {
  padding: 16rpx 16rpx 18rpx;
}

.product-name {
  display: -webkit-box;
  overflow: hidden;
  min-height: 68rpx;
  color: var(--ink);
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 600;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-tags {
  display: flex;
  gap: 6rpx;
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
}

.product-tags .tag {
  flex-shrink: 0;
  padding: 3rpx 8rpx;
  border-radius: 5rpx;
  background: #fbf0df;
  color: #986c32;
  font-size: 17rpx;
  line-height: 24rpx;
}

.product-price {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 10rpx;
}

.product-price .price {
  font-size: 28rpx;
}

.product-sales {
  overflow: hidden;
  color: var(--muted);
  font-size: 18rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.farm-card {
  padding: 22rpx;
  border: 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fffaf2 0%, #f9efe5 100%);
  box-shadow: 0 8rpx 24rpx rgba(63, 45, 34, 0.08);
}

.farm-card-copy {
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(179, 42, 42, 0.1);
}

.farm-card-title {
  display: block;
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 29rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.farm-card-sub {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 30rpx;
}

.farm-stats {
  display: flex;
  padding: 18rpx 0 14rpx;
}

.farm-stat {
  flex: 1;
  text-align: center;
}

.farm-num {
  display: block;
  color: var(--red);
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 700;
}

.farm-label {
  display: block;
  margin-top: 2rpx;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 26rpx;
}

.farmer-list {
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(63, 45, 34, 0.06);
}

.farmer-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 0;
}

.farmer-avatar {
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: var(--paper-deep);
}

.farmer-info {
  flex: 1;
  min-width: 0;
}

.farmer-name {
  display: block;
  color: var(--ink);
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
}

.farmer-project {
  display: block;
  overflow: hidden;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 28rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.farm-button {
  margin-top: 14rpx;
}

.story-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.story-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  border: 0;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(63, 45, 34, 0.06);
}

.story-cover {
  flex-shrink: 0;
  width: 178rpx;
  height: 142rpx;
  border-radius: 14rpx;
  background: var(--paper-deep);
}

.story-body {
  flex: 1;
  min-width: 0;
}

.story-title {
  display: block;
  overflow: hidden;
  color: var(--ink);
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.story-sub {
  display: block;
  margin-top: 6rpx;
  color: var(--red);
  font-size: 20rpx;
  line-height: 28rpx;
}

.story-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 30rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.study-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 26rpx 24rpx;
  border: 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #b33a32 0%, #7e1b1b 100%);
  box-shadow: 0 10rpx 24rpx rgba(126, 27, 27, 0.2);
}

.study-title {
  display: block;
  color: #fff8ef;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.study-sub {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 248, 239, 0.78);
  font-size: 20rpx;
  line-height: 28rpx;
}

.study-action {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(255, 248, 239, 0.55);
  border-radius: 999rpx;
  color: #fff8ef;
  font-size: 20rpx;
  line-height: 28rpx;
}

.home-empty {
  margin: 24rpx;
}


.member-growth {
  margin-top: 0;
  padding: 22rpx 24rpx 24rpx;
  border-top: 1rpx solid var(--line-soft);
}

.growth-copy {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 31rpx;
}

.member-growth .progress {
  height: 12rpx;
  margin-top: 14rpx;
  background: #F0E3D0;
}

.medal-section {
  margin-top: 34rpx;
}

.medal-scroll {
  width: 100%;
}

.medal-row {
  display: inline-flex;
  gap: 18rpx;
  padding-right: 32rpx;
}

.home-medal {
  position: relative;
  width: 174rpx;
  overflow: hidden;
  padding: 0 0 16rpx;
  text-align: center;
}

.home-medal.locked {
  opacity: .65;
}

.home-medal-image {
  display: block;
  width: 174rpx;
  height: 160rpx;
  background: var(--surface-warm);
}

.home-medal-lock {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  padding: 4rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(53, 43, 37, .64);
  color: #fff;
  font-size: 17rpx;
}

.home-medal-name {
  display: block;
  margin: 12rpx 10rpx 0;
  overflow: hidden;
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.home-medal-progress {
  display: block;
  margin-top: 5rpx;
  color: var(--red);
  font-size: 18rpx;
}

.home-medal-empty {
  margin-top: 16rpx;
}
