.medals-page {
  padding-bottom: 50rpx;
}

.medal-hero {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 260rpx;
  padding: 44rpx 32rpx 42rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #8f2020 0%, #bd4938 58%, #d19548 100%);
  color: #fff8ed;
}

.medal-hero::after {
  position: absolute;
  right: -80rpx;
  bottom: -100rpx;
  width: 320rpx;
  height: 320rpx;
  border: 1rpx solid rgba(255, 247, 229, .35);
  border-radius: 50%;
  content: '';
}

.hero-seal {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  border: 3rpx solid rgba(255, 248, 237, .9);
  border-radius: 50%;
  color: #fff8ed;
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  transform: rotate(-8deg);
}

.medal-hero-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.eyebrow.light {
  color: rgba(255, 248, 237, .78);
}

.medal-hero-title {
  display: block;
  margin-top: 8rpx;
  color: #fff8ed;
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
}

.medal-hero-sub {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 248, 237, .78);
  font-size: 22rpx;
  line-height: 32rpx;
}

.medal-summary {
  position: absolute;
  right: 30rpx;
  top: 38rpx;
  z-index: 1;
  text-align: right;
}

.medal-summary-num {
  color: #fff8ed;
  font-size: 46rpx;
  font-weight: 700;
}

.medal-summary-label {
  color: rgba(255, 248, 237, .74);
  font-size: 20rpx;
}

.growth-card {
  margin: -28rpx 32rpx 0;
  padding: 24rpx;
  position: relative;
  z-index: 2;
}

.growth-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.growth-level {
  display: block;
  color: var(--red);
  font-size: 28rpx;
  font-weight: 700;
}

.growth-exp {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.growth-link {
  color: var(--red);
  font-size: 22rpx;
}

.growth-card .progress {
  margin-top: 20rpx;
}

.growth-tip {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.medal-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin: 28rpx 32rpx 0;
}

.medal-card {
  overflow: hidden;
  padding: 0;
}

.medal-card.locked {
  opacity: .72;
}

.medal-cover-wrap {
  position: relative;
  height: 230rpx;
  overflow: hidden;
  background: var(--surface-warm);
}

.medal-cover {
  width: 100%;
  height: 100%;
}

.medal-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(37, 31, 28, .34);
  color: #fff;
  font-size: 22rpx;
}

.medal-state {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: var(--red);
  color: #fff8ed;
  font-size: 18rpx;
}

.medal-body {
  padding: 18rpx;
}

.medal-name,
.medal-subtitle,
.medal-condition {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.medal-name {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.medal-subtitle {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.medal-progress-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.medal-progress {
  flex: 1;
  height: 8rpx;
}

.medal-progress-text {
  flex-shrink: 0;
  color: var(--red);
  font-size: 18rpx;
}

.medal-condition {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 19rpx;
}

.medal-empty {
  margin: 28rpx 32rpx 0;
}
