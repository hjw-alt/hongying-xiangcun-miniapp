.profile-page {
  padding-bottom: 80rpx;
}

.member-hero {
  padding: 40rpx 32rpx 34rpx;
  background: linear-gradient(145deg, #a93732 0%, #741b1b 100%);
  color: #fff6e8;
}

.member-hero-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border: 2rpx solid rgba(255, 246, 232, 0.62);
  border-radius: 50%;
  background: rgba(255, 246, 232, 0.15);
  color: #fff6e8;
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
}

.member-user {
  flex: 1;
  min-width: 0;
}

.member-name {
  display: block;
  color: #fff6e8;
  font-size: 34rpx;
  line-height: 46rpx;
  font-weight: 700;
}

.member-code {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: rgba(255, 246, 232, 0.68);
  font-size: 20rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.member-level {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 94rpx;
  height: 94rpx;
  border: 2rpx solid rgba(255, 246, 232, 0.55);
  border-radius: 50%;
  color: #fff6e8;
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  font-weight: 700;
}

.member-level text {
  margin-top: 3rpx;
  color: rgba(255, 246, 232, 0.82);
  font-family: inherit;
  font-size: 18rpx;
  font-weight: 400;
}

.member-progress-head {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
  color: rgba(255, 246, 232, 0.9);
  font-size: 23rpx;
}

.member-progress {
  height: 14rpx;
  margin-top: 10rpx;
  border: 1rpx solid rgba(255, 246, 232, 0.25);
  background: rgba(255, 246, 232, 0.2);
}

.member-progress .progress-inner {
  background: #f0c36a;
}

.member-next {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 246, 232, 0.68);
  font-size: 20rpx;
}

.member-stats {
  display: flex;
  margin: -20rpx 32rpx 0;
  padding: 24rpx 10rpx;
  position: relative;
  z-index: 2;
}

.member-stat {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid var(--line);
}

.member-stat:last-child {
  border-right: 0;
}

.member-stat-num {
  display: block;
  color: var(--red);
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
}

.member-stat-label {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.quick-card {
  display: flex;
  margin: 24rpx 32rpx 0;
  padding: 20rpx 10rpx;
}

.quick-item {
  flex: 1;
  text-align: center;
}

.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin: 0 auto 8rpx;
  border-radius: 50%;
  background: rgba(179, 42, 42, 0.1);
  color: var(--red);
  font-size: 23rpx;
  font-weight: 700;
}

.quick-title,
.quick-sub {
  display: block;
}

.quick-title {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
}

.quick-sub {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 19rpx;
}

.profile-section {
  margin-top: 34rpx;
}

.medal-scroll {
  width: 100%;
  white-space: nowrap;
}

.medal-row {
  display: flex;
  gap: 22rpx;
  padding: 6rpx 4rpx 10rpx;
}

.mini-medal {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 150rpx;
}

.mini-medal-image,
.more-medal-icon {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: var(--surface-warm);
  border: 1rpx solid var(--line);
}

.mini-medal-name {
  display: block;
  max-width: 150rpx;
  margin-top: 9rpx;
  overflow: hidden;
  color: var(--ink-2);
  font-size: 21rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.more-medal-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--red);
  font-size: 45rpx;
}

.medal-empty-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx;
}

.medal-empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(199, 154, 70, 0.16);
  color: var(--gold);
  font-size: 32rpx;
}

.medal-empty-card view {
  flex: 1;
  min-width: 0;
}

.medal-empty-title,
.medal-empty-sub {
  display: block;
}

.medal-empty-title {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 600;
}

.medal-empty-sub {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.medal-empty-arrow {
  color: var(--muted);
  font-size: 34rpx;
}

.tabs {
  display: flex;
  gap: 6rpx;
  margin-top: 0;
  padding: 8rpx;
}

.tab {
  flex: 1;
  min-width: 0;
  padding: 15rpx 4rpx;
  border-radius: var(--radius-sm);
  color: var(--ink-2);
  font-size: 21rpx;
  text-align: center;
}

.tab.active {
  background: var(--red);
  color: #fff6e8;
  font-weight: 600;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
}

.order-card {
  padding: 22rpx;
}

.order-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.order-no {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--muted);
  font-size: 20rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.order-payment,
.order-status {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
}

.order-payment {
  background: rgba(199, 154, 70, 0.15);
  color: #8a6420;
}

.order-status {
  background: rgba(179, 42, 42, 0.1);
  color: var(--red);
}

.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 14rpx;
}

.order-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--ink);
  font-size: 24rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.order-price {
  flex-shrink: 0;
  color: var(--ink-2);
  font-size: 23rpx;
}

.order-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line-soft);
}

.order-time,
.record-time,
.ledger-time {
  color: var(--muted);
  font-size: 19rpx;
}

.order-total-wrap {
  text-align: right;
}

.order-reward {
  display: block;
  color: var(--red);
  font-size: 19rpx;
}

.order-total {
  display: block;
  margin-top: 3rpx;
  color: var(--red-deep);
  font-size: 27rpx;
  font-weight: 700;
}

.record-list,
.ledger-list {
  margin-top: 20rpx;
  padding: 8rpx 22rpx;
}

.record-item,
.ledger-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.record-item:last-child,
.ledger-item:last-child {
  border-bottom: 0;
}

.record-head,
.ledger-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.record-title,
.ledger-description {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 600;
}

.record-points,
.ledger-value {
  color: var(--red);
  font-size: 23rpx;
  font-weight: 700;
}

.record-note {
  display: block;
  margin-top: 7rpx;
  color: var(--ink-2);
  font-size: 23rpx;
  line-height: 35rpx;
}

.record-time,
.ledger-time {
  display: block;
  margin-top: 6rpx;
}

.ledger-copy {
  flex: 1;
  min-width: 0;
}

.ledger-description {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ledger-value-wrap {
  flex-shrink: 0;
  text-align: right;
}

.ledger-value.negative {
  color: var(--ink-2);
}

.ledger-balance {
  display: block;
  margin-top: 3rpx;
  color: var(--muted);
  font-size: 18rpx;
}

.profile-empty {
  margin-top: 20rpx;
  padding: 30rpx 20rpx;
}

.empty-button {
  margin-top: 22rpx;
}
