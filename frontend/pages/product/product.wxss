.gallery {
  height: 720rpx;
  background: var(--paper-deep);
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.info-card {
  position: relative;
  margin: -40rpx 32rpx 0;
  padding: 30rpx;
  z-index: 2;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.price-now {
  color: var(--red);
  font-size: 46rpx;
  line-height: 58rpx;
  font-weight: 700;
}

.sales {
  margin-left: auto;
  color: var(--muted);
  font-size: 22rpx;
}

.product-name {
  display: block;
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 700;
  font-family: "Songti SC", "STSong", serif;
}

.product-summary {
  display: block;
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 38rpx;
}

.growth-strip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 32rpx 0;
  padding: 18rpx 22rpx;
  background: linear-gradient(120deg, #9a2928 0%, #bd7146 100%);
  border: 0;
  box-shadow: var(--shadow-float);
}

.growth-strip-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border: 2rpx solid rgba(255, 246, 232, 0.8);
  border-radius: 50%;
  color: #fff6e8;
  font-family: "Songti SC", "STSong", serif;
  font-size: 27rpx;
  font-weight: 700;
}

.growth-strip-copy {
  flex: 1;
  min-width: 0;
}

.growth-strip-title,
.growth-strip-sub {
  display: block;
  overflow: hidden;
  color: #fff6e8;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.growth-strip-title {
  font-size: 25rpx;
  font-weight: 600;
}

.growth-strip-sub {
  margin-top: 4rpx;
  color: rgba(255, 246, 232, 0.78);
  font-size: 20rpx;
}

.growth-strip-arrow {
  flex-shrink: 0;
  color: #fff6e8;
  font-size: 21rpx;
}

.payment-panel {
  padding: 26rpx;
}

.panel-title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.panel-title {
  display: block;
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 29rpx;
  font-family: "Songti SC", "STSong", serif;
  font-weight: 700;
}

.current-points {
  color: var(--red);
  font-size: 21rpx;
}

.payment-switch {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.payment-option {
  flex: 1;
  min-width: 0;
  padding: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-warm);
}

.payment-option.active {
  border-color: var(--red);
  background: rgba(179, 42, 42, 0.07);
  box-shadow: inset 0 0 0 2rpx rgba(179, 42, 42, 0.08);
}

.payment-option.disabled {
  opacity: 0.52;
}

.payment-option-title,
.payment-option-value,
.payment-option-sub {
  display: block;
}

.payment-option-title {
  color: var(--ink-2);
  font-size: 22rpx;
}

.payment-option-value {
  margin-top: 4rpx;
  color: var(--red);
  font-size: 28rpx;
  font-weight: 700;
}

.payment-option-sub {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 29rpx;
}

.payment-hint {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 32rpx;
}

.farmer-name {
  display: block;
  margin-top: 12rpx;
  color: var(--red-deep);
  font-size: 28rpx;
  font-weight: 600;
}

.farmer-note {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 38rpx;
}

.story-card-text {
  display: block;
  margin-top: 12rpx;
  padding: 22rpx;
  border-left: 6rpx solid var(--gold);
  background: var(--surface-warm);
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 40rpx;
}

.custom-tip {
  display: block;
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 38rpx;
}

.custom-input {
  width: 100%;
  height: 170rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-warm);
  font-size: 25rpx;
  line-height: 38rpx;
}

.quantity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quantity-label {
  color: var(--ink-2);
  font-size: 25rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.step-button {
  width: 60rpx;
  height: 60rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  color: var(--ink-2);
  font-size: 30rpx;
  line-height: 58rpx;
  text-align: center;
}

.step-value {
  min-width: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.detail-text {
  display: block;
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 44rpx;
}

.bottom-placeholder {
  height: 180rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--line);
}

.bar-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 78rpx;
  height: 78rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-warm);
}

.bar-icon-img {
  width: 42rpx;
  height: 42rpx;
}

.bar-badge {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--red);
  color: #FFF6E8;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
}

.cart-button,
.buy-button {
  flex: 1;
  height: 80rpx;
  line-height: 78rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.cart-button {
  border: 1rpx solid var(--red);
  background: var(--surface-warm);
  color: var(--red);
}

.buy-button {
  background: linear-gradient(180deg, #C13A32 0%, #8C1F1F 100%);
  color: #FFF6E8;
}

.product-state {
  margin: 32rpx;
}
