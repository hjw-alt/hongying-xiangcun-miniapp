.tip {
  margin: 24rpx 32rpx 0;
  padding: 18rpx 24rpx;
  border-radius: var(--radius-sm);
  background: rgba(179, 42, 42, 0.08);
  color: var(--red);
  font-size: 24rpx;
}

.address-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 24rpx 32rpx 0;
}

.address-card {
  padding: 26rpx;
}

.address-card.selected {
  border-color: var(--red);
  box-shadow: 0 0 0 2rpx rgba(179, 42, 42, 0.2);
}

.address-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.address-name {
  color: var(--ink);
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.address-phone {
  color: var(--ink-2);
  font-size: 26rpx;
}

.address-badge {
  margin-left: auto;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(179, 42, 42, 0.1);
  color: var(--red);
  font-size: 20rpx;
}

.address-detail {
  display: block;
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 40rpx;
}

.address-actions {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-soft);
}

.address-action {
  color: var(--ink-2);
  font-size: 24rpx;
}

.address-action.danger {
  color: var(--red);
}

.bottom-placeholder {
  height: 160rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--line);
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  background: rgba(46, 33, 25, 0.46);
}

.modal {
  width: 100%;
  padding: 34rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--surface);
}

.modal-title {
  display: block;
  margin-bottom: 20rpx;
  color: var(--red-deep);
  font-size: 34rpx;
  line-height: 46rpx;
  font-weight: 700;
}

.modal input {
  width: 100%;
  height: 84rpx;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-warm);
  font-size: 26rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 6rpx 0 24rpx;
  color: var(--ink-2);
  font-size: 26rpx;
}

.switch {
  position: relative;
  width: 88rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: var(--line);
  transition: background 0.2s ease;
}

.switch.on {
  background: var(--red);
}

.switch-dot {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFFFFF;
  transition: left 0.2s ease;
}

.switch.on .switch-dot {
  left: 44rpx;
}

.address-state {
  margin: 24rpx 32rpx 0;
}
