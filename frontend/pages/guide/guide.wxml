<view class="page">
  <view class="search-bar">
    <input value="{{keyword}}" placeholder="搜索村落或地区" bindinput="onKeyword" bindconfirm="onSearch" confirm-type="search" />
    <button class="search-button" bindtap="onSearch">搜索</button>
  </view>

  <map
    class="map"
    latitude="{{center.latitude}}"
    longitude="{{center.longitude}}"
    scale="10"
    markers="{{markers}}"
    show-location
    bindmarkertap="onMarkerTap"
  ></map>

  <view class="section">
    <view class="section-head">
      <view>
        <text class="eyebrow">主题线路</text>
        <view class="section-title">三条推荐走法</view>
      </view>
    </view>
    <view class="route-list">
      <view wx:for="{{routes}}" wx:key="id" class="route-card card" data-id="{{item.id}}" bindtap="onRoute">
        <image class="route-cover" src="{{item.coverSrc}}" mode="aspectFill" />
        <view class="route-body">
          <text class="route-name">{{item.name}}</text>
          <text class="route-meta">{{item.metaText}} · {{item.spotNames.length}} 个点位</text>
          <view class="route-spots">
            <text wx:for="{{item.spotNames}}" wx:for-item="spot" wx:key="*this" class="tag">{{spot}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <text class="eyebrow">红色村落</text>
        <view class="section-title">共 {{villages.length}} 个村域</view>
      </view>
    </view>
    <view class="village-list">
      <view wx:for="{{villages}}" wx:key="id" class="village-card card" data-id="{{item.id}}" bindtap="onVillage">
        <image class="village-cover" src="{{item.coverSrc}}" mode="aspectFill" />
        <view class="village-body">
          <view class="village-head">
            <text class="village-name">{{item.name}}</text>
            <text class="village-region">{{item.region}}</text>
          </view>
          <text class="village-summary">{{item.summary}}</text>
          <view class="village-tags">
            <text wx:for="{{item.themes}}" wx:for-item="theme" wx:key="*this" class="tag tag-red">{{theme}}</text>
          </view>
          <view class="village-stats">
            <text>景点 {{item.spotCount}}</text>
            <text>故事 {{item.storyCount}}</text>
            <text>文创 {{item.productCount}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{selectedRoute}}" class="modal-mask" bindtap="closeRoute">
    <view class="modal" catchtap="noop">
      <text class="modal-title">{{selectedRoute.name}}</text>
      <text class="modal-sub">{{selectedRoute.metaText}}</text>
      <text class="modal-body">{{selectedRoute.summary}}</text>
      <view class="modal-spots">
        <view wx:for="{{selectedRoute.spotNames}}" wx:key="*this" class="modal-spot">
          <text class="spot-index">{{index + 1}}</text>
          <text class="spot-name">{{item}}</text>
        </view>
      </view>
      <button class="primary-button" data-village="{{villages[0].id}}" bindtap="onRouteSpot">从第一个村开始</button>
    </view>
  </view>
</view>
