.medal-detail-page {
  padding-bottom: 50rpx;
}

.detail-banner {
  position: relative;
  height: 580rpx;
  overflow: hidden;
  background: #4b3b34;
}

.detail-cover {
  width: 100%;
  height: 100%;
  filter: saturate(.55) grayscale(.18);
}

.detail-banner.unlocked .detail-cover {
  filter: saturate(1.08);
}

.detail-cover-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(33, 24, 21, .08) 25%, rgba(33, 24, 21, .78) 100%);
}

.detail-banner-copy {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: 42rpx;
  color: #fff8ed;
}

.detail-status {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 248, 237, .18);
  font-size: 20rpx;
}

.detail-name {
  display: block;
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 54rpx;
  line-height: 68rpx;
  font-weight: 700;
}

.detail-subtitle {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 248, 237, .82);
  font-size: 24rpx;
}

.detail-card {
  margin: -28rpx 32rpx 0;
  position: relative;
  z-index: 2;
  padding: 30rpx;
}

.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-state {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--surface-warm);
  color: var(--muted);
  font-size: 21rpx;
}

.detail-state.on {
  background: rgba(179, 42, 42, .1);
  color: var(--red);
}

.detail-description {
  display: block;
  margin-top: 18rpx;
  color: var(--ink-2);
  font-size: 27rpx;
  line-height: 44rpx;
}

.detail-rule {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line-soft);
}

.detail-rule-label {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.detail-progress-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.detail-progress-row .progress {
  flex: 1;
}

.detail-progress-text {
  color: var(--red);
  font-size: 24rpx;
  font-weight: 700;
}

.detail-rule-tip {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 34rpx;
}

.detail-note {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 28rpx;
  padding: 18rpx;
  border-radius: var(--radius-sm);
  background: var(--surface-warm);
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 34rpx;
}

.detail-note-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--red);
  color: #fff;
  font-family: "Songti SC", "STSong", serif;
  font-size: 20rpx;
}

.detail-empty {
  margin: 28rpx 32rpx 0;
}
