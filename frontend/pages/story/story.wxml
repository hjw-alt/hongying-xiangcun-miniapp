<view class="page">
  <view class="hero">
    <view class="hero-body">
      <view class="seal">红迹</view>
      <view class="hero-title">扫码读一段历史</view>
      <view class="hero-sub">人物、事件、求学与风物，六段湘潭红色记忆</view>
    </view>
  </view>

  <view class="search-bar">
    <input value="{{keyword}}" placeholder="搜索故事标题" bindinput="onKeyword" bindconfirm="onSearch" confirm-type="search" />
    <button class="search-button" bindtap="onSearch">搜索</button>
  </view>

  <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}">
    <view class="chip-row">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="chip {{category === item ? 'active' : ''}}"
        data-value="{{item}}"
        bindtap="onCategory"
      >{{item}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="empty story-empty">故事加载中…</view>
  <view wx:elif="{{stories.length === 0}}" class="empty story-empty">暂无相关故事</view>
  <view wx:else class="story-list">
    <view wx:for="{{stories}}" wx:key="id" class="story-card card" data-id="{{item.id}}" bindtap="onStory">
      <image class="story-cover" src="{{item.coverSrc}}" mode="aspectFill" />
      <view class="story-body">
        <view class="story-head">
          <text class="story-category">{{item.category}}</text>
          <text class="story-views">{{item.viewText}} 次阅读</text>
        </view>
        <text class="story-title">{{item.title}}</text>
        <text class="story-era">{{item.era}}</text>
        <text class="story-summary">{{item.summary}}</text>
        <view class="story-foot">
          <text class="story-cta">扫码可听 · 查看故事 ›</text>
        </view>
      </view>
    </view>
  </view>
</view>
