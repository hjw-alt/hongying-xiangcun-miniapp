.hero {
  padding-bottom: 16rpx;
}

.hero-title {
  margin-top: 14rpx;
  color: #FFF6E8;
  font-size: 46rpx;
  line-height: 62rpx;
  font-weight: 700;
  font-family: "Songti SC", "STSong", serif;
  letter-spacing: 3rpx;
}

.hero-sub {
  margin-top: 10rpx;
  color: rgba(255, 246, 232, 0.82);
  font-size: 24rpx;
  line-height: 36rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 32rpx 0;
  padding: 12rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-float);
}

.search-bar input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-sm);
  background: var(--surface-warm);
  font-size: 25rpx;
}

.search-button {
  flex-shrink: 0;
  width: 132rpx;
  height: 72rpx;
  line-height: 70rpx;
  background: var(--red);
  color: #FFF6E8;
  font-size: 25rpx;
}

.category-scroll {
  margin: 24rpx 0 0;
  padding: 0 32rpx;
  white-space: nowrap;
}

.story-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin: 24rpx 32rpx 0;
}

.story-card {
  overflow: hidden;
}

.story-cover {
  width: 100%;
  height: 320rpx;
  background: var(--paper-deep);
}

.story-body {
  padding: 24rpx;
}

.story-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.story-category {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(179, 42, 42, 0.1);
  color: var(--red);
  font-size: 21rpx;
}

.story-views {
  color: var(--muted);
  font-size: 21rpx;
}

.story-title {
  display: block;
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 34rpx;
  line-height: 46rpx;
  font-weight: 700;
  font-family: "Songti SC", "STSong", serif;
}

.story-era {
  display: block;
  margin-top: 6rpx;
  color: var(--gold);
  font-size: 22rpx;
}

.story-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 40rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.story-foot {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-soft);
}

.story-cta {
  color: var(--red);
  font-size: 24rpx;
}

.story-empty {
  margin: 24rpx 32rpx 0;
}
