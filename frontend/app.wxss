page {
  --paper: #F7F1E8;
  --paper-deep: #EFE3D2;
  --surface: #FFFFFF;
  --surface-warm: #FDF6EC;
  --ink: #2E2119;
  --ink-2: #6B5442;
  --muted: #9A8578;
  --line: #E6D8C6;
  --line-soft: #F1E7DA;
  --red: #B32A2A;
  --red-deep: #7E1B1B;
  --gold: #C79A46;
  --jade: #4E6B55;
  --radius-sm: 10rpx;
  --radius: 18rpx;
  --radius-lg: 26rpx;
  --shadow-card: 0 4rpx 0 rgba(126, 27, 27, 0.06), 0 14rpx 30rpx rgba(75, 45, 25, 0.08);
  --shadow-float: 0 8rpx 0 rgba(126, 27, 27, 0.10), 0 22rpx 44rpx rgba(75, 45, 25, 0.14);

  min-height: 100%;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
}

view,
text,
input,
textarea,
button,
image,
scroll-view,
swiper {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius);
  background: transparent;
  color: var(--ink);
  font-family: inherit;
  font-size: 28rpx;
  line-height: 1.3;
}

button::after {
  border: 0;
}

input,
textarea {
  font-family: inherit;
}

.page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 160rpx;
  background: var(--paper);
}

.panel {
  margin: 24rpx 32rpx 0;
  padding: 30rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
}

.section {
  margin: 32rpx 32rpx 0;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.eyebrow {
  display: block;
  color: var(--red);
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.section-title {
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 36rpx;
  line-height: 50rpx;
  font-weight: 700;
  font-family: "Songti SC", "STSong", serif;
  letter-spacing: 2rpx;
}

.section-head .section-title {
  margin-bottom: 0;
}

.more {
  flex-shrink: 0;
  color: var(--red);
  font-size: 24rpx;
  line-height: 36rpx;
}

.seal {
  display: inline-block;
  padding: 5rpx 14rpx;
  border-radius: 6rpx;
  background: rgba(179, 42, 42, 0.92);
  color: #FFF6E8;
  font-size: 20rpx;
  line-height: 30rpx;
  letter-spacing: 2rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, #B33A32 0%, #7E1B1B 100%);
}

.hero-veil {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(46, 20, 16, 0.28) 0%, rgba(46, 20, 16, 0.72) 100%);
}

.hero-body {
  position: relative;
  padding: 44rpx 40rpx 40rpx;
}

.hero-title {
  margin-top: 16rpx;
  color: #FFF6E8;
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 700;
  font-family: "Songti SC", "STSong", serif;
  letter-spacing: 4rpx;
}

.hero-sub {
  margin-top: 10rpx;
  color: rgba(255, 246, 232, 0.82);
  font-size: 25rpx;
  line-height: 38rpx;
}

.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
}

.row-card {
  display: flex;
  gap: 22rpx;
  padding: 22rpx;
}

.row-card image {
  flex-shrink: 0;
  border-radius: var(--radius-sm);
  background: var(--paper-deep);
}

.row-info {
  flex: 1;
  min-width: 0;
}

.row-title,
.row-sub {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-title {
  color: var(--ink);
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.row-sub {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 34rpx;
}

.price {
  color: var(--red);
  font-weight: 700;
}

.price-old {
  margin-left: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  text-decoration: line-through;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.tag {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: var(--surface-warm);
  color: var(--ink-2);
  font-size: 21rpx;
  line-height: 30rpx;
}

.tag-red {
  background: rgba(179, 42, 42, 0.1);
  color: var(--red);
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 34rpx;
}

.chip.active {
  border-color: var(--red);
  background: var(--red);
  color: #FFF6E8;
  font-weight: 600;
}

.primary-button {
  width: 100%;
  height: 86rpx;
  line-height: 84rpx;
  background: linear-gradient(180deg, #C13A32 0%, #8C1F1F 100%);
  color: #FFF6E8;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 0 rgba(126, 27, 27, 0.18);
}

.ghost-button {
  background: var(--surface-warm);
  border: 1rpx solid var(--line);
  color: var(--ink-2);
}

.empty {
  padding: 40rpx 30rpx;
  border: 1rpx dashed var(--line);
  border-radius: var(--radius);
  background: var(--surface-warm);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 38rpx;
  text-align: center;
}

.progress {
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--line);
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #C79A46 0%, #B32A2A 100%);
}

.rise {
  animation: riseIn 0.6s cubic-bezier(0.22, 0.86, 0.34, 1) both;
}

@keyframes riseIn {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
